# Copy to .env and fill in. .env is gitignored.

# Hugging Face token (needed to pull gated Llama weights). Request access at
# https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct first.
HF_TOKEN=

# Where HF models are cached on the host (mounted into the container so you
# don't re-download the 16GB model on every rebuild). Defaults to ~/.cache/huggingface.
HF_HOME=

# Only required if running the external-API audit path (--allow-external).
# Never commit real keys.
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
